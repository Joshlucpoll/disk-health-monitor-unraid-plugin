  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
mkdir -p /var/local/emhttp/plugins/disk-health-monitor
cat > /usr/local/emhttp/plugins/disk-health-monitor/include/collect.php << 'PHPEOF'
<?php
/*
 * Cron snapshot collector — runs every 30 minutes via /etc/cron.d/disk-health-monitor.
 * Writes one row per physical disk into a SQLite database.
 */

$dbPath = '/var/local/emhttp/plugins/disk-health-monitor/history.db';
$db = new SQLite3($dbPath);
$db->busyTimeout(5000);
$db->exec('PRAGMA journal_mode=WAL');
$db->exec('CREATE TABLE IF NOT EXISTS snapshots (
  id              INTEGER PRIMARY KEY AUTOINCREMENT,
  ts              INTEGER NOT NULL,
  disk_name       TEXT    NOT NULL,
  disk_serial     TEXT    NOT NULL,
  logical_name    TEXT,
  health_score    INTEGER,
  temperature     INTEGER,
  power_on_hours  INTEGER,
  realloc_sectors INTEGER,
  pending_sectors INTEGER,
  uncorrectable   INTEGER,
  cmd_timeouts    INTEGER,
  capacity        INTEGER,
  used_bytes      INTEGER
)');
$db->exec('CREATE INDEX IF NOT EXISTS idx_serial_ts ON snapshots (disk_serial, ts)');

function r($c){ exec($c.' 2>/dev/null',$o); return $o; }

function diskSerial($d) {
  foreach (r("smartctl -i $d") as $l) {
    if (preg_match('/Serial Number\s*:\s*(.+)/i',$l,$m)) return trim($m[1]);
  }
  return basename($d);
}

function smartData($d) {
  $r=['temperature'=>null,'powerOnHours'=>0,'reallocSectors'=>0,'pendingSectors'=>0,
      'cmdTimeout'=>0,'uncorrectable'=>0,'criticalWarning'=>0,'status'=>'unknown','attrs'=>[]];
  foreach (r("smartctl -a $d") as $l) {
    if (preg_match('/SMART overall-health self-assessment test result\s*:\s*(\w+)/i',$l,$m))
      $r['status'] = (strtoupper(trim($m[1]))==='PASSED') ? 'passed' : 'failed';
    if (preg_match('/^Temperature\s*:\s*([\d,]+)\s*Celsius/i',$l,$m))
      $r['temperature']=(int)str_replace(',','',$m[1]);
    if (preg_match('/^Power On Hours\s*:\s*([\d,]+)/i',$l,$m))
      $r['powerOnHours']=(int)str_replace(',','',$m[1]);
    if (preg_match('/^Critical Warning\s*:\s*(0x[\da-fA-F]+|\d+)/i',$l,$m))
      $r['criticalWarning']=hexdec($m[1]);
    if (preg_match('/^\s*(\d+)\s+(\S+)\s+\S+\s+\d+\s+\d+\s+\d+\s+\S+\s+\S+\s+\S+\s+(\d+)/',$l,$m)) {
      $id=(int)$m[1]; $val=(int)$m[3];
      if($id===190||$id===194) $r['temperature']=$val;
      if($id===9)              $r['powerOnHours']=$val;
      if($id===5)              $r['reallocSectors']=$val;
      if($id===197)            $r['pendingSectors']=$val;
      if($id===188)            $r['cmdTimeout']=$val;
      if($id===198)            $r['uncorrectable']=$val;
    }
  }
  return $r;
}

function healthScore($sm) {
  $s=100; $t=$sm['temperature'];
  if($t!==null){if($t>65)$s-=20;elseif($t>55)$s-=10;elseif($t>50)$s-=5;}
  if($sm['reallocSectors']>0) $s-=min(30,$sm['reallocSectors']);
  if($sm['pendingSectors']>0) $s-=min(40,$sm['pendingSectors']*5);
  if($sm['uncorrectable']>0)  $s-=15;
  if($sm['cmdTimeout']>0)     $s-=10;
  if($sm['criticalWarning']>0)$s-=20;
  if($sm['powerOnHours']>0)   $s-=min(20,(int)($sm['powerOnHours']/10000)*2);
  if($sm['status']==='failed')$s=min(50,$s);
  return max(0,min(100,$s));
}

function buildDeviceMap() {
  $map=[]; $path='/var/local/emhttp/disks.ini';
  if (!file_exists($path)) return $map;
  $ini=@parse_ini_file($path,true,INI_SCANNER_RAW);
  if (!$ini) return $map;
  foreach ($ini as $section => $v) {
    $dev=basename(trim($v['device']??'','"'));
    $name=trim($v['name']??'','"');
    $type=strtolower(trim($v['type']??'','"'));
    if($dev==='') continue;
    $group=($type==='parity'||$type==='data')?'array':($type==='cache'?'pool':($type==='flash'?'flash':'unassigned'));
    $poolName=($type==='cache')?preg_replace('/\d+$/','',($name?:$section)):null;
    $map[$dev]=['logicalName'=>$name?:('/dev/'.$dev),'group'=>$group,'poolName'=>$poolName];
  }
  return $map;
}

function diskUsage($devBasename,$group,$poolName,$logicalName) {
  $iniPath='/var/local/emhttp/disks.ini';
  if (file_exists($iniPath)) {
    $ini=@parse_ini_file($iniPath,true,INI_SCANNER_RAW);
    if($ini){
      $sect=null;
      foreach($ini as $k=>$v){if(!empty($v['device'])&&trim($v['device'],'"')===$devBasename){$sect=$v;break;}}
      if((!$sect||!isset($sect['fsSize'])||$sect['fsSize']==='')&&$group==='pool'&&$poolName){
        foreach($ini as $v){$n=trim($v['name']??'','"');$rp=preg_replace('/\d+$/','',$n?:'none');if($rp===$poolName&&isset($v['fsSize'])&&$v['fsSize']!==''){$sect=$v;break;}}
      }
      if($sect&&isset($sect['fsSize'])&&isset($sect['fsFree'])&&$sect['fsSize']!==''){
        $fst=trim($sect['fsSize'],'"');$ffr=trim($sect['fsFree'],'"');
        if(is_numeric($fst)&&is_numeric($ffr)&&(int)$fst>0){$fsize=(int)$fst*1024;$ffree=(int)$ffr*1024;return[$fsize,$fsize-$ffree];}
      }
    }
  }
  $mps=[];
  if($group==='array'){if(stripos($logicalName,'parity')===0)return[0,0];$slug=strtolower(preg_replace('/\s+/','',$logicalName));$mps[]='/mnt/'.$slug;}
  elseif($group==='pool'&&$poolName){$mps[]='/mnt/'.strtolower($poolName);}
  elseif($group==='flash'){$mps[]='/boot';}
  foreach($mps as $mp){if(!is_dir($mp))continue;foreach(r("df -B1 -P ".escapeshellarg($mp))as $i=>$l){if($i===0)continue;$p=preg_split('/\s+/',trim($l));if(count($p)>=3)return[(int)$p[1],(int)$p[2]];}}
  return [0,0];
}

$ts = time();
$deviceMap = buildDeviceMap();
$rawLines = []; exec('lsblk -dpb -o NAME,SIZE,TYPE 2>/dev/null', $rawLines);

$stmt = $db->prepare('INSERT INTO snapshots
  (ts,disk_name,disk_serial,logical_name,health_score,temperature,power_on_hours,
   realloc_sectors,pending_sectors,uncorrectable,cmd_timeouts,capacity,used_bytes)
  VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)');

foreach ($rawLines as $line) {
  $p = preg_split('/\s+/', trim($line), 3);
  if (count($p)<3 || $p[2]!=='disk') continue;
  $name = basename($p[0]);
  if (preg_match('/^(loop|dm-|sr|zd)/', $name)) continue;

  $info     = $deviceMap[$name] ?? null;
  $logical  = $info['logicalName'] ?? ('/dev/'.$name);
  $group    = $info['group']       ?? 'unassigned';
  $poolName = $info['poolName']    ?? null;

  $sm        = smartData($p[0]);
  $serial    = diskSerial($p[0]);
  $sc        = healthScore($sm);
  [$cap,$used] = diskUsage($name, $group, $poolName, $logical);

  $stmt->bindValue(1, $ts,                  SQLITE3_INTEGER);
  $stmt->bindValue(2, $name,                SQLITE3_TEXT);
  $stmt->bindValue(3, $serial,              SQLITE3_TEXT);
  $stmt->bindValue(4, $logical,             SQLITE3_TEXT);
  $stmt->bindValue(5, $sc,                  SQLITE3_INTEGER);
  $stmt->bindValue(6, $sm['temperature'],   SQLITE3_INTEGER);
  $stmt->bindValue(7, $sm['powerOnHours'],  SQLITE3_INTEGER);
  $stmt->bindValue(8, $sm['reallocSectors'],SQLITE3_INTEGER);
  $stmt->bindValue(9, $sm['pendingSectors'],SQLITE3_INTEGER);
  $stmt->bindValue(10,$sm['uncorrectable'], SQLITE3_INTEGER);
  $stmt->bindValue(11,$sm['cmdTimeout'],    SQLITE3_INTEGER);
  $stmt->bindValue(12,(int)$p[1],           SQLITE3_INTEGER);
  $stmt->bindValue(13,$used,                SQLITE3_INTEGER);
  $stmt->reset(); $stmt->execute();
}

// Prune rows older than 90 days
$cutoff = $ts - (90 * 86400);
$db->exec("DELETE FROM snapshots WHERE ts < $cutoff");
$db->close();
PHPEOF
echo "collect.php written"
]]></INLINE>
  </FILE>

  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
cat > /usr/local/emhttp/plugins/disk-health-monitor/include/history.php << 'PHPEOF'
<?php
header('Content-Type: application/json');
header('Cache-Control: no-cache');

$serial = trim($_GET['serial'] ?? '');
$range  = $_GET['range'] ?? '7d';

if ($serial === '') { echo json_encode(['error' => 'serial required']); exit; }

$ranges = ['24h' => 86400, '7d' => 604800, '30d' => 2592000, '90d' => 7776000];
$seconds = $ranges[$range] ?? $ranges['7d'];

$dbPath = '/var/local/emhttp/plugins/disk-health-monitor/history.db';
if (!file_exists($dbPath)) {
  echo json_encode(['points' => [], 'delta' => null]);
  exit;
}

$db   = new SQLite3($dbPath, SQLITE3_OPEN_READONLY);
$db->busyTimeout(3000);
$now  = time();
$from = $now - $seconds;

$stmt = $db->prepare(
  'SELECT ts, health_score, temperature, power_on_hours,
          realloc_sectors, pending_sectors, uncorrectable, cmd_timeouts,
          capacity, used_bytes
   FROM snapshots
   WHERE disk_serial = ? AND ts >= ?
   ORDER BY ts ASC'
);
$stmt->bindValue(1, $serial, SQLITE3_TEXT);
$stmt->bindValue(2, $from,   SQLITE3_INTEGER);
$res  = $stmt->execute();

$points = [];
while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
  $points[] = [
    'ts'             => (int)$row['ts'],
    'healthScore'    => (int)$row['health_score'],
    'temperature'    => $row['temperature'] !== null ? (int)$row['temperature'] : null,
    'powerOnHours'   => (int)$row['power_on_hours'],
    'reallocSectors' => (int)$row['realloc_sectors'],
    'pendingSectors' => (int)$row['pending_sectors'],
    'uncorrectable'  => (int)$row['uncorrectable'],
    'cmdTimeouts'    => (int)$row['cmd_timeouts'],
  ];
}

// Compute delta: latest vs earliest point in range
$delta = null;
if (count($points) >= 2) {
  $first = $points[0];
  $last  = $points[count($points) - 1];
  $delta = [
    'healthScore'  => $last['healthScore']  - $first['healthScore'],
    'temperature'  => ($last['temperature'] !== null && $first['temperature'] !== null)
                       ? $last['temperature'] - $first['temperature'] : null,
    'reallocSectors' => $last['reallocSectors'] - $first['reallocSectors'],
  ];
}

// Also fetch the single earliest point ever for long-term baseline
$base = $db->querySingle(
  "SELECT health_score, temperature, realloc_sectors, ts
   FROM snapshots WHERE disk_serial = " . $db->escapeString($serial) .
  " ORDER BY ts ASC LIMIT 1", true
);

$db->close();

echo json_encode([
  'points'   => $points,
  'delta'    => $delta,
  'baseline' => $base ? [
    'ts'           => (int)$base['ts'],
    'healthScore'  => (int)$base['health_score'],
    'temperature'  => $base['temperature'] !== null ? (int)$base['temperature'] : null,
    'reallocSectors' => (int)$base['realloc_sectors'],
  ] : null,
], JSON_UNESCAPED_SLASHES);
PHPEOF
echo "history.php written"
]]></INLINE>
  </FILE>

  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
echo "*/30 * * * * root /usr/bin/php /usr/local/emhttp/plugins/disk-health-monitor/include/collect.php >/dev/null 2>&1" \
  > /etc/cron.d/disk-health-monitor
chmod 644 /etc/cron.d/disk-health-monitor
echo "Cron job installed"
]]></INLINE>
  </FILE>

  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
rm -rf /usr/local/emhttp/plugins/disk-health-monitor
rm -f /etc/cron.d/disk-health-monitor
echo "Disk Health Monitor removed."
]]></INLINE>
  </FILE>

</PLUGIN>