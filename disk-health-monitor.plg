    <span class="dhm-pill dhm-pill-ok" data-filter="dhm-ok" onclick="window.dhmPillClick('dhm-ok')">
      <i class="fa fa-check-circle"></i><span class="dhm-n" id="dhm-healthy">-</span>Healthy
    </span>
    <span class="dhm-pill dhm-pill-warn" data-filter="dhm-warn" onclick="window.dhmPillClick('dhm-warn')">
